# ======================================
# APPLICATION
# ======================================

APP_ENV=development
APP_NAME=Orbital Guardian
# FRONTEND_URL locks CORS down in production (comma-separated).
FRONTEND_URL=*

# ======================================
# DATABASE  (REQUIRED)
# ======================================

DATABASE_URL=postgresql://user:password@localhost:5432/orbital_guardian

# ======================================
# AUTHENTICATION
# ======================================
# Generate a strong key: python -c "import secrets; print(secrets.token_urlsafe(48))"

JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ======================================
# ORBITAL DATA
# ======================================

CELESTRAK_BASE_URL=https://celestrak.org/NORAD/elements/gp.php
CELESTRAK_CACHE_TTL_SECONDS=14400

# ======================================
# OPTIONAL CATALOG PROVIDER
# ======================================
# Example: SatNOGS DB. Leave blank to use TLE-derived data + curated registry.

CATALOG_PROVIDER=
CATALOG_API_BASE_URL=
CATALOG_API_KEY=

# ======================================
# OPTIONAL MISSION METADATA PROVIDER
# ======================================

MISSION_METADATA_PROVIDER=
MISSION_METADATA_API_BASE_URL=
MISSION_METADATA_API_KEY=

# ======================================
# FIREBASE AUTHENTICATION
# Firebase console -> Project settings -> General -> Project ID
# ======================================

FIREBASE_PROJECT_ID=

# ======================================
# AI  (GOOGLE GEMINI â€” https://aistudio.google.com/apikey)
# Without a key, the Copilot answers deterministically from real
# system data + the bundled knowledge base.
# ======================================

AI_PROVIDER=gemini
GEMINI_API_KEY=
AI_MODEL=gemini-3.6-flash
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# ======================================
# EMBEDDINGS  (Gemini â€” uses GEMINI_API_KEY)
# ======================================

EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=text-embedding-004

# ======================================
# VECTOR DATABASE  (OPTIONAL)
# ======================================

VECTOR_DB_PROVIDER=
VECTOR_DB_URL=
VECTOR_DB_API_KEY=

# ======================================
# CACHE / JOB QUEUE  (OPTIONAL)
# ======================================
# Reserved for multi-worker job execution.

REDIS_URL=

# ======================================
# EMAIL - OPTIONAL NOTIFICATIONS
# ======================================

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
